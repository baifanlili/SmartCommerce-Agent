# API
API_PORT=8000
FRONTEND_PORT=3000

# 基础设施
REDIS_URL=redis://redis:6379/0

# 请求身份上下文。开发环境可使用匿名开发身份；非 development 环境自动要求受信网关注入身份头。
ENVIRONMENT=development
IDENTITY_MODE=development
IDENTITY_GATEWAY_TOKEN=

# 模型配置。默认示例使用 Mock；本机可改成 deepseek 并填写密钥。
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=deepseekflash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_MODE=chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 管理员配置台认证令牌。生产环境必须替换为 Secret Manager 注入的高强度令牌。
ADMIN_TOKEN=change-me-in-development

# 运行期模型配置持久化。本地直接运行 Python 时使用相对路径；Docker Compose 固定写入容器内 /app/var/runtime-config.sqlite3 并挂载命名卷。
# 未配置加密密钥时，仅 development 环境使用内置开发密钥；生产环境必须由 Secret Manager 注入稳定的 Fernet 密钥，禁止提交真实密钥。
RUNTIME_CONFIG_DB_PATH=runtime-config.sqlite3
RUNTIME_CONFIG_ENCRYPTION_KEY=
